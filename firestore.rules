rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User Profiles ────────────────────────────────────────────────────────
    // Each user can only read/write their OWN document
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.uid == userId; // cannot change uid
      allow delete: if false; // accounts are never deleted from client
    }

    // ── Voice Rooms ──────────────────────────────────────────────────────────
    match /frnd_rooms/{roomId} {
      // Anyone logged in can read rooms
      allow read: if request.auth != null;

      // Only verified phone users (non-anonymous) can CREATE a room
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.keys().hasAll(['title', 'host', 'hostUid', 'createdAt'])
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the room HOST can update or delete the room
      allow update, delete: if request.auth != null
                             && resource.data.hostUid == request.auth.uid;

      // ── Room Messages ──────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasAll(['sender', 'text', 'createdAt'])
                      && request.resource.data.text.size() <= 500; // 500 char limit
        allow update, delete: if false; // messages are immutable
      }
    }

    // ── Matchmaking Queue ────────────────────────────────────────────────────
    match /frnd_queue/{queueId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null; // pairing logic needs cross-doc update
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid; // own entry only
    }

    // ── Active Match Calls ───────────────────────────────────────────────────
    match /frnd_calls/{callId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null; // both users can clean up
    }
  }
}
